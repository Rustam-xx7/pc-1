      "index": "a0l",
      "roundness": null,
      "seed": 1942193837,
      "version": 512,
      "versionNonce": 2105397987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783066324002,
      "link": null,
      "locked": false,
      "text": "O(1) < O(logn) < O(sqrt n) < O(n) < O(n log n ) < O(n^2) < O(n^3) < O(2^n) < O(n!) < O(n^n)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O(1) < O(logn) < O(sqrt n) < O(n) < O(n log n ) < O(n^2) < O(n^3) < O(2^n) < O(n!) < O(n^n)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V4z31Y1nDaxr0x9PckhCb",
      "type": "text",
      "x": 67.61938613191121,
      "y": 287.28477788360044,
      "width": 850.8994750976562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
