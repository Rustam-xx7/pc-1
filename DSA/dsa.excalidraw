    {
      "id": "gfOD7PV33XLGYYuIGLRoK",
      "type": "text",
      "x": 51.664257195170364,
      "y": 214.62244442852256,
      "width": 905.2396240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
